# =====================================================
# Gubkin Business Club — environment variables
# Copy this file to `.env.local` and fill in the values.
# =====================================================

# --- Supabase ------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (transactional email) ----------------------------
RESEND_API_KEY=
# From-address used in emails (must be a verified Resend sender)
ADMIN_EMAIL=hello@gubkin-bc.ru
# Where team notifications about new applications are sent
TEAM_EMAIL=team@gubkin-bc.ru

# --- Admin panel --------------------------------------------
# Password to enter /admin. Keep it long and secret.
ADMIN_PASSWORD=
# Optional: separate secret for signing session cookies.
# If not set, ADMIN_PASSWORD is used as the secret.
ADMIN_SESSION_SECRET=

# --- Public links -------------------------------------------
NEXT_PUBLIC_TG_LINK=https://t.me/gubkin_bc
NEXT_PUBLIC_VK_LINK=
NEXT_PUBLIC_IG_LINK=
NEXT_PUBLIC_CONTACT_EMAIL=hello@gubkin-bc.ru
NEXT_PUBLIC_SPEAKER_EMAIL=speakers@gubkin-bc.ru

# --- Analytics ----------------------------------------------
NEXT_PUBLIC_YM_ID=

# --- Misc ---------------------------------------------------
# Public URL of the site — used for OG tags, sitemap, robots.
NEXT_PUBLIC_SITE_URL=https://gubkin-bc.ru
