# =====================================================
# Бизнес-клуб Губкина — платформа организаторов
# Скопируйте этот файл в `.env` и заполните значения.
# =====================================================

# --- База данных ----------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gubkin_bc?schema=public"

# --- Telegram ---------------------------------------------------
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Имя бота без @ — для кнопки «Подключить Telegram» в профиле
TELEGRAM_BOT_USERNAME=

# --- Вход ---------------------------------------------------------
# В CRM входят по ролям. Пароль нужен только Администратору клуба.
# Задайте свой пароль здесь (в репозиторий .env не попадает). Дальше его можно
# сменить в «Настройки → Доступ»; в базе хранится только хэш.
# Пароля по умолчанию нет: пока он не задан, войти администратором нельзя.
ADMIN_PASSWORD=

# --- Сессии -------------------------------------------------
# Секрет для подписи cookie сессии. Сгенерируйте случайную строку.
SESSION_SECRET=change-me-to-a-random-secret

# --- Приложение -----------------------------------------------
APP_URL=http://localhost:3000
TZ=Europe/Moscow

# Сухой прогон уведомлений: не слать в Telegram, а печатать в консоль и считать
# доставленным. Удобно проверять правила локально без бота. На сервере — не включать.
TELEGRAM_DRY_RUN=0

# Включить фоновые джобы (cron + бот) в текущем процессе.
# В dev с несколькими воркерами/инстансами оставляйте включённым только на одном.
ENABLE_SCHEDULER=true
