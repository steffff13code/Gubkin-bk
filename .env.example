# =====================================================
# Бизнес-клуб Губкина — платформа организаторов
# Скопируйте этот файл в `.env` и заполните значения.
# =====================================================

# --- База данных ----------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gubkin_bc?schema=public"

# --- Telegram ---------------------------------------------------
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Имя бота без @ — используется виджетом Telegram Login
TELEGRAM_BOT_USERNAME=
# Telegram ID администраторов через запятую, напр. "111111111,222222222"
ADMIN_TELEGRAM_IDS=

# --- Сессии -------------------------------------------------
# Секрет для подписи cookie сессии. Сгенерируйте случайную строку.
SESSION_SECRET=change-me-to-a-random-secret

# --- Приложение -----------------------------------------------
APP_URL=http://localhost:3000
TZ=Europe/Moscow

# Включить фоновые джобы (cron + бот) в текущем процессе.
# В dev с несколькими воркерами/инстансами оставляйте включённым только на одном.
ENABLE_SCHEDULER=true
